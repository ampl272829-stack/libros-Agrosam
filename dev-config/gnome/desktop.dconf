[app-folders]
folder-children=['System', 'Utilities', 'YaST', 'Pardus']

[app-folders/folders/Pardus]
categories=['X-Pardus-Apps']
name='X-Pardus-Apps.directory'
translate=true

[app-folders/folders/System]
apps=['nm-connection-editor.desktop', 'org.gnome.baobab.desktop', 'org.gnome.DiskUtility.desktop', 'org.gnome.Logs.desktop', 'org.freedesktop.MalcontentControl.desktop', 'org.gnome.tweaks.desktop', 'org.gnome.SystemMonitor.desktop']
name='X-GNOME-Shell-System.directory'
translate=true

[app-folders/folders/Utilities]
apps=['org.gnome.Decibels.desktop', 'org.gnome.Connections.desktop', 'org.gnome.Evince.desktop', 'org.gnome.font-viewer.desktop', 'org.gnome.Loupe.desktop']
name='X-GNOME-Shell-Utilities.directory'
translate=true

[app-folders/folders/YaST]
categories=['X-SuSE-YaST']
name='suse-yast.directory'
translate=true

[background]
color-shading-type='solid'
picture-options='zoom'
picture-uri='file:///home/moshe/.config/background'
picture-uri-dark='file:///home/moshe/.config/background'
primary-color='#000000000000'
secondary-color='#000000000000'

[break-reminders/eyesight]
play-sound=true

[break-reminders/movement]
duration-seconds=uint32 300
interval-seconds=uint32 1800
play-sound=true

[datetime]
automatic-timezone=false

[input-sources]
per-window=false
show-all-sources=false
sources=[('xkb', 'us')]
xkb-options=['terminate:ctrl_alt_bksp', 'lv3:ralt_switch']

[interface]
accent-color='yellow'
clock-format='24h'
color-scheme='prefer-dark'
cursor-size=24
cursor-theme='default'
enable-hot-corners=true
icon-theme='hicolor'
show-battery-percentage=false

[notifications]
application-children=['org-gnome-software', 'gnome-power-panel', 'firefox', 'spotify', 'org-gnome-texteditor', 'org-manjaro-pamac-manager', 'org-gnome-settings', 'org-telegram-desktop', 'org-gnome-extensions', 'org-gnome-baobab', 'gnome-about-panel', 'org-gnome-totem', 'org-gnome-decibels', 'cockos-reaper', 'org-gnome-tweaks', 'com-mitchellh-ghostty', 'org-gnome-nautilus', 'code']
show-banners=true

[notifications/application/cockos-reaper]
application-id='cockos-reaper.desktop'

[notifications/application/code]
application-id='code.desktop'

[notifications/application/com-mitchellh-ghostty]
application-id='com.mitchellh.ghostty.desktop'

[notifications/application/firefox]
application-id='firefox.desktop'

[notifications/application/gnome-about-panel]
application-id='gnome-about-panel.desktop'

[notifications/application/gnome-power-panel]
application-id='gnome-power-panel.desktop'

[notifications/application/org-gnome-baobab]
application-id='org.gnome.baobab.desktop'

[notifications/application/org-gnome-decibels]
application-id='org.gnome.Decibels.desktop'

[notifications/application/org-gnome-extensions]
application-id='org.gnome.Extensions.desktop'

[notifications/application/org-gnome-nautilus]
application-id='org.gnome.Nautilus.desktop'

[notifications/application/org-gnome-settings]
application-id='org.gnome.Settings.desktop'

[notifications/application/org-gnome-software]
application-id='org.gnome.Software.desktop'

[notifications/application/org-gnome-texteditor]
application-id='org.gnome.TextEditor.desktop'

[notifications/application/org-gnome-totem]
application-id='org.gnome.Totem.desktop'

[notifications/application/org-gnome-tweaks]
application-id='org.gnome.tweaks.desktop'

[notifications/application/org-manjaro-pamac-manager]
application-id='org.manjaro.pamac.manager.desktop'

[notifications/application/org-telegram-desktop]
application-id='org.telegram.desktop.desktop'

[notifications/application/spotify]
application-id='spotify.desktop'

[peripherals/keyboard]
numlock-state=true

[peripherals/mouse]
accel-profile='default'
natural-scroll=false
speed=-0.013215859030836996

[peripherals/touchpad]
click-method='fingers'
edge-scrolling-enabled=false
natural-scroll=true
tap-to-click=true
two-finger-scrolling-enabled=true

[screen-time-limits]
daily-limit-seconds=uint32 28800

[screensaver]
color-shading-type='solid'
lock-delay=uint32 0
picture-options='zoom'
picture-uri='file:///home/moshe/.local/share/backgrounds/2025-08-14-22-26-44-XCx0bJS.jpeg'
primary-color='#000000000000'
secondary-color='#000000000000'

[search-providers]
sort-order=['org.gnome.Settings.desktop', 'org.gnome.Contacts.desktop', 'org.gnome.Nautilus.desktop']

[session]
idle-delay=uint32 900

[sound]
event-sounds=true
theme-name='__custom'

[wm/keybindings]
close=['<Super>z']
switch-input-source=@as []
switch-input-source-backward=@as []
switch-windows=['<Super>space']
switch-windows-backward=['<Shift><Super>space']

[wm/preferences]
button-layout='appmenu:close'
num-workspaces=6
