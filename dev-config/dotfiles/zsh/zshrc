# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load.
ZSH_THEME="powerlevel10k/powerlevel10k" # La ruta completa al tema

# Plugins to load (esto carga los plugins)
# Asegúrate de que todos los plugins que quieras estén aquí
plugins=(
  git
  zsh-syntax-highlighting
 # zsh-autosuggestions
)

# ESTA LÍNEA ES CRUCIAL: Carga Oh My Zsh y todos los plugins definidos arriba.
# Las configuraciones de plugins y tus personalizaciones deben ir DESPUÉS de esta línea.
source $ZSH/oh-my-zsh.sh

# --- CONFIGURACIONES DE PLUGINS (DESPUÉS DE 'source $ZSH/oh-my-zsh.sh') ---

# Configuración de zsh-syntax-highlighting (Colores de comandos)
# Estas líneas deben estar DESPUÉS de 'source $ZSH/oh-my-zsh.sh'
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main)
ZSH_HIGHLIGHT_STYLES[command]='fg=cyan,bold'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=red,bold'
ZSH_HIGHLIGHT_STYLES[path]='fg=yellow'
ZSH_HIGHLIGHT_STYLES[alias]='fg=magenta'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=green'

# Configuración de zsh-autosuggestions
# Puedes cambiar el color de la sugerencia (por defecto es gris)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8' # '8' es un color gris de tu paleta

# --- TUS PERSONALIZACIONES (DESPUÉS DE TODO LO ANTERIOR) ---
# Mueve todas tus variables de entorno, alias, y funciones aquí.
# ¡IMPORTANTE! Asegúrate de que NINGUNA de estas líneas produzca salida a la consola
# directamente al inicio. Si una función imprime algo, no la llames aquí.

# Tus Variables de Entorno (copia de .bashrc)
export EDITOR="nano"
export MY_CUSTOM_VAR="Hola Mundo"
export PATH="$HOME/.local/bin:$PATH"

# Tus Alias (copia de .bashrc)
alias cls='clear'
alias docs='cd ~/Documents'
alias gs='git status'

# Tus Funciones (copia de .bashrc)
# Si tu función 'mygreeting' imprimía algo, NO la llames directamente aquí.
# mygreeting() { echo "¡Bienvenido, $USER!"; } # Define la función, pero no la llames aquí.

# Cualquier otro comando que genere salida (como 'neofetch', 'fortune', etc.)
# DEBE ir aquí, al final, o ser llamado solo cuando sea necesario.
# Por ejemplo, si tenías 'neofetch' en tu .zshrc, ponlo aquí.

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
alias opencode="~/.local/bin/opencode"

# Función para hacerme hablar
function decir() {
    echo "$*" | espeak-ng -v es -s 150
}

